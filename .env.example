# Esempi non sensibili per il solo backend Node locale.
# Il server Node legge le variabili del processo, non carica automaticamente .env.
# API_PORT=3001
# PORT, se presente, precede API_PORT.
# PORT=3001
# DATA_DIR=./data
# SEED_DEMO=1
# SEED_DEMO=0 impedisce solo l'inserimento iniziale degli esempi in un database nuovo.
# TRUST_PROXY=1 va usato solo dietro un proxy HTTPS controllato.
#
# La pubblicazione gratuita usa Cloudflare Workers Free e wrangler.jsonc.
# SQLite del Durable Object e risorse statiche sono configurati tramite binding.
# DATA_DIR, API_PORT e TRUST_PROXY non configurano il Worker.
# Non serve una chiave di un servizio realtime e non inserire token o password qui.
